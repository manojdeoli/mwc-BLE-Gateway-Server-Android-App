<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECEFF1">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#00695C"
        android:paddingTop="36dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hotel BLE Scanner"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <TextView
            android:id="@+id/ipAddressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server: http://0.0.0.0:8080"
            android:textSize="12sp"
            android:textColor="#B2DFDB"
            android:gravity="center"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── Beacon Status card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📡  BEACON STATUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00695C"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/beaconGate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gate: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E0F2F1"
                        android:textColor="#004D40"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/beaconKiosk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kiosk: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E0F2F1"
                        android:textColor="#004D40"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/beaconElevator"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Elevator: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E0F2F1"
                        android:textColor="#004D40"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/beaconRoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Room: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E0F2F1"
                        android:textColor="#004D40"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Mobility Context card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚶  MOBILITY CONTEXT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/contextMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mode: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E3F2FD"
                        android:textColor="#0D47A1"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/contextConfidence"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Conf: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E3F2FD"
                        android:textColor="#0D47A1"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/contextMotion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Motion: --"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E3F2FD"
                        android:textColor="#0D47A1"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/contextSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Speed: -- km/h"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:background="#E3F2FD"
                        android:textColor="#0D47A1"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Biometric Status card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔐  BIOMETRIC STATUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6A1B9A"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/biometricStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔒 Identity Required"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:gravity="center"
                    android:background="#F3E5F5"
                    android:textColor="#4A148C" />

            </LinearLayout>

            <!-- ── Transport Debug card ── -->
            <LinearLayout
                android:id="@+id/simSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:elevation="2dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛠  TRANSPORT DEBUG"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/debugDeviceMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MODE: --"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:padding="7dp"
                        android:background="#FFF3E0"
                        android:textColor="#BF360C"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/debugSession"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SESSION: --"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:padding="7dp"
                        android:background="#FFF3E0"
                        android:textColor="#BF360C"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/debugBiometric"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BIO: --"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:padding="7dp"
                        android:background="#FFF3E0"
                        android:textColor="#BF360C"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/debugAdvisory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ADVISORY: --"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:padding="7dp"
                        android:background="#FFF3E0"
                        android:textColor="#BF360C"
                        android:layout_marginStart="5dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/debugNearStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AT STATION: --"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:padding="7dp"
                    android:background="#FFF3E0"
                    android:textColor="#BF360C" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Bottom button bar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingTop="10dp"
        android:paddingBottom="36dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="8dp">

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="▶  Start Scanning"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00897B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="■  Stop Scanning"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E53935"
            android:alpha="0.5"
            android:enabled="false"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
